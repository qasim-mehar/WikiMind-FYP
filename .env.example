# WikiMind local/demo environment -- PLACEHOLDERS ONLY.
# Copy this file to `.env` and fill in your own keys. NEVER commit `.env`.
# The demo targets a throwaway sandbox database, never the live corpus.

# ---- Compose Postgres (local sandbox credentials, not real secrets) ----
# If you change POSTGRES_PASSWORD, change the password in BOTH DSNs below too.
POSTGRES_USER=wikimind
POSTGRES_PASSWORD=CHANGE_ME_DEMO_PASSWORD
POSTGRES_DB=wikimind_demo

# ---- Database DSNs (must stay on the sandbox database) ----
# WIKIMIND_DB is used by `wikimind db migrate` / `project create` in the
# entrypoint; WIKIMIND_WEB_DB is what the webapp queries (WIKIMIND_DB is only a
# fallback). Both point at the Compose `db` service, host `db` on port 5432.
WIKIMIND_DB=postgresql://wikimind:CHANGE_ME_DEMO_PASSWORD@db:5432/wikimind_demo
WIKIMIND_WEB_DB=postgresql://wikimind:CHANGE_ME_DEMO_PASSWORD@db:5432/wikimind_demo

# ---- Webapp identity and persistence ----
WIKIMIND_WEB_PROJECT=webapp-sandbox
WIKIMIND_WEB_COSTS_PATH=/app/data/webapp/costs.jsonl
WIKIMIND_WEB_UPLOAD_DIR=/app/data/webapp/uploads
# Deterministic, keyless embedder: no model download, no HuggingFace access.
# Set to `local` only if you build with the `embed` extra installed yourself.
WIKIMIND_WEB_EMBEDDER=fake

# ---- Model providers (real keys are required only for Add / Ask) ----
# Leave WIKIMIND_LIVE=0 to browse the pages with $0 spend. Set it to 1 only
# after replacing BOTH placeholder keys below with real credentials.
WIKIMIND_LIVE=0
GEMINI_API_KEY=REPLACE_WITH_YOUR_GEMINI_KEY
OPENROUTER_API_KEY=REPLACE_WITH_YOUR_OPENROUTER_KEY
WIKIMIND_GROBID_URL=

# NOTE: WIKIMIND_COST_DB_MIRROR is intentionally absent. Never add it to the
# demo .env; the entrypoint refuses to start if it is set.
